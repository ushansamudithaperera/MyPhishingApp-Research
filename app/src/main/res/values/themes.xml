<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base theme -->
    <style name="Base.Theme.MyPhishingApp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
    </style>

    <style name="Theme.MyPhishingApp" parent="Base.Theme.MyPhishingApp"/>

    <!-- Tab text style -->
    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Input Layout -->
    <style name="PhishInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/bg_input</item>
        <item name="boxStrokeColor">@color/divider</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="errorTextColor">@color/accent_red</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="startIconTint">@color/text_muted</item>
    </style>

    <!-- Primary button (red) -->
    <style name="PhishButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Secondary button (outline) -->
    <style name="PhishButton.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Allow button (green) -->
    <style name="PhishButton.Allow" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent_green_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Block button (red) -->
    <style name="PhishButton.Block" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent_red_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Defense button (orange/dark) -->
    <style name="PhishButton.Defense" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_orange</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/accent_orange</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>