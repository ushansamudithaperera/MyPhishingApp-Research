<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml — PhishGuard v2.0
    Includes:
      • SMS permissions
      • Camera (QR scanner)
      • POST_NOTIFICATIONS (Android 13+)
      • BIND_ACCESSIBILITY_SERVICE
      • Receivers + Service declarations
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════
         PERMISSIONS
    ═══════════════════════════════════════════════════════════ -->

    <!-- Internet (active defense backend + OkHttp) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- SMS interception -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Camera (QR code scanner) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Push notifications (Android 13+ / API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Accessibility service binding -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <!-- Foreground service (keep accessibility service alive) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Vibration for notifications -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Hardware features (camera optional — don't block install without it) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- ═══════════════════════════════════════════════════════════
         APPLICATION
    ═══════════════════════════════════════════════════════════ -->
    <application
        android:name=".PhishGuardApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyPhishingApp"
        android:usesCleartextTraffic="true">

        <!-- ── Main Activity ──────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">

            <!-- Launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- ── SMS BroadcastReceiver ──────────────────────────── -->
        <!--
            Priority 999 ensures PhishGuard receives SMS before
            other apps. Exported=true required for system to call it.
        -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">

            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- ── Notification Dismiss Receiver ─────────────────── -->
        <receiver
            android:name=".NotificationDismissReceiver"
            android:exported="false"/>

        <!-- ── Accessibility Service ──────────────────────────── -->
        <!--
            BIND_ACCESSIBILITY_SERVICE permission ensures only the
            system can bind to this service.

            User must enable manually:
            Settings → Accessibility → Downloaded Apps → PhishGuard
        -->
        <service
            android:name=".PhishingAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">

            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <!-- Links to res/xml/accessibility_service_config.xml -->
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>